# Template di configurazione locale. Copia in .env e personalizza.
# Il file .env NON deve essere committato (e` in .gitignore).

# --- Database MySQL ---
MYSQL_HOST=localhost
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=maquetaweb

# --- Flask ---
SECRET_KEY=cambiami-in-produzione

# --- NAS (SFTP) ---
NAS_HOST=
NAS_PORT=22
NAS_USER=
NAS_PASSWORD=
NAS_BASE_PATH=applicazione/MaquetaFiles

# --- Coda upload differita (opzionale) ---
# STAGING_FOLDER=
UPLOAD_WORKER_INTERVAL=2.0
UPLOAD_MAX_ATTEMPTS=5
