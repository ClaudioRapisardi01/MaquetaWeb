# Ambiente locale: NON committare credenziali
.env
.env.local

# Certificati TLS — gestiti da nginx, non da gunicorn. Rimane il glob
# per sicurezza nel caso qualcuno generi un cert locale per test.
certs/*.pem
certs/*.key
certs/*.crt

# Password admin generata al primo avvio
admin_password.txt

# Cartella di staging upload (file in transito verso il NAS)
staging/

# Upload utenti (immagini caricate localmente)
static/uploads/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
